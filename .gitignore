# kunglao-agent gitignore — scoped to this skill only
# Compiled Python
__pycache__/
*.pyc
*.pyo

# Virtualenv (created by the documented install command: uv sync --locked)
.venv/

# Generated release artifact (issue #80) — CI stores it as a workflow artifact
/release-receipt.json

# Test artifacts
*.tmp
*.bak
*.bak-*
*~
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Logs (transient)
*.log

# Workspace state snapshots (not skill code)
.state/
# Malware samples — NEVER tracked
**/bins/
test_workspace/
runs/

# Eval harness generated receipts (reproducible via scripts/kunglao-eval.py --all)
eval/receipts/

# Review gate + progress (never tracked)
.review-gate/
.claude/reviews/
progress.txt

# Subagent review (Gate 5, issue #462) — per-commit evidence; regenerated
# each commit. NOT for tracking (would pollute history with stale reviews).
.subagent-review/

# Pytest JUnit artifact (generated by Gate 2, observed by quality_gates)
.pytest-result.xml

# Security — never track secrets, hooks, or skill packages
.claude/settings.json
.claude/hooks/
.claude/skills/
.claude/commands/

# Research + planning intermediates (local-only, never shipped in the skill)
.claude/prds/
# any research-tree variant dir (-alignment, -native, future forks; #355)
.research-tree*/
.claude/PRPs/

# Runtime hook state (per-session activation, regenerated by hook_activation.py)
.hook_state.json

# Session logs (transient)
.claude/logs/

# Analysis workspace (per-sample, never tracked)
analysis_space/

# Memory/dump artifacts
*.dmp
*.raw
*.vmem

# pytest cache
.pytest_cache/

# Deployment secrets/topology (per-machine; .env.example is the template)
.env
.review/

# Dev worktrees (parallel branch isolation; #472-class hygiene: never tracked)
.worktrees/
docs/superpowers/
