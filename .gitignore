# kunglao-agent gitignore — scoped to this skill only
# Compiled Python
__pycache__/
*.pyc
*.pyo

# Virtualenv (created by the documented install command: uv sync --locked)
.venv/

# Generated release artifact (issue #80) — CI stores it as a workflow artifact
/release-receipt.json

# Test artifacts
*.tmp
*.bak
*.bak-*
*~
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Logs (transient)
*.log

# Workspace state snapshots (not skill code)
.state/
# Malware samples — NEVER tracked
**/bins/
test_workspace/
runs/

# Eval harness generated receipts (reproducible via scripts/kunglao-eval.py --all)
eval/receipts/

# Review gate + progress (never tracked)
.review-gate/
.claude/reviews/
progress.txt

# Security — never track secrets, hooks, or skill packages
.claude/settings.json
.claude/hooks/
.claude/skills/
.claude/commands/

# Research + planning intermediates (local-only, never shipped in the skill)
.claude/prds/
.research-tree/
.research-tree-alignment/
.research-tree-native/
.claude/PRPs/

# Runtime hook state (per-session activation, regenerated by hook_activation.py)
.hook_state.json

# Session logs (transient)
.claude/logs/

# Analysis workspace (per-sample, never tracked)
analysis_space/

# Memory/dump artifacts
*.dmp
*.raw
*.vmem

# pytest cache
.pytest_cache/
