#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""{{name}} — disasm-pipeline skeleton (generated by scripts/template_gen.py, #278).

FIELD-PROVEN FLOW this skeleton encodes (templates/scripts/disasm-pipeline.py.tmpl):
  1. load the sample binary and pin the disassembly architecture
  2. disassemble at each ENTRY_POINTS address (capstone; arch per sample)
  3. collect xrefs from the disassembly to the interesting targets
  4. emit a summary JSON (per-entry instruction counts, xref targets,
     suspicious call sites) into OUTPUT_DIR

WHAT THE ANALYST MUST FILL (all marked TODO in the body):
  * pin_arch() — confirm the architecture/mode (x86, x64, ARM, ...) for
    this sample; capstone is a repo dependency (pyproject.toml)
  * interesting_targets() — the addresses/symbols to collect xrefs to
  * analyze() — per-entry analysis notes (what the flow does, what to
    chase next); keep the mechanical parts (disasm loop, xref collection,
    summary emission) as-is

CLI:  python {{name}}.py
Exit: 0 = summary emitted; 1 = disasm failed/incomplete; 2 = configuration
      error (bad entry points, sample missing, capstone unavailable).
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

try:  # capstone is a repo dependency; degrade with a clear message when absent.
    import capstone as _capstone
except Exception:  # pragma: no cover
    _capstone = None

# ---- parameters (instantiated by template_gen.py from disasm-pipeline) ----
SAMPLE_PATH = "{{sample_path}}"
SAMPLE_SHA256 = "{{sample_sha256}}"
ENTRY_POINTS_CSV = "{{entry_points}}"  # e.g. "0x401000,0x401020" — comma-separated hex
OUTPUT_DIR = "{{output_dir}}"


def _parse_csv_hex(text: str) -> list[int]:
    """'0x401000, 0x401020' -> [0x401000, 0x401020]."""
    return [int(part.strip(), 16) for part in text.split(",") if part.strip()]


def pin_arch() -> tuple[int, int]:
    """TODO(analyst): return (capstone CS_ARCH_*, CS_MODE_*) for this sample
    (x86/x64, ARM, ARM64, ...). Default: x86-32."""
    if _capstone is None:
        raise NotImplementedError("TODO(analyst): capstone missing — install the repo deps")
    return _capstone.CS_ARCH_X86, _capstone.CS_MODE_32


def interesting_targets() -> list[int]:
    """TODO(analyst): the addresses/symbols to collect xrefs to (decrypt
    routine, stage loader, string-table builder, ...). Default: none."""
    return []


def disassemble_at(entry: int) -> list[dict]:
    """Disassemble at `entry` (mechanical once pin_arch() is right)."""
    if _capstone is None:
        raise NotImplementedError("TODO(analyst): capstone missing — install the repo deps")
    arch, mode = pin_arch()
    md = _capstone.Cs(arch, mode)
    sample = Path(SAMPLE_PATH)
    blob = sample.read_bytes()
    code = blob[entry:] if entry < len(blob) else b""
    return [
        {"addr": insn.address, "bytes": insn.bytes.hex(), "mnemonic": insn.mnemonic,
         "op_str": insn.op_str}
        for insn in md.disasm(code[:0x400], entry)  # TODO(analyst): window size
    ]


def analyze(entry: int, insns: list[dict]) -> dict:
    """TODO(analyst): per-entry analysis notes — what the flow at this entry
    does and what to chase next. Keep it mechanical: counts + xrefs."""
    return {
        "entry": hex(entry),
        "insn_count": len(insns),
        "call_sites": [hex(i["addr"]) for i in insns if i["mnemonic"] == "call"],
        "notes": "TODO(analyst): analysis notes for this entry",
    }


def main() -> int:
    if _capstone is None:
        print("ERROR capstone unavailable (repo dependency not installed)", file=sys.stderr)
        return 2
    sample = Path(SAMPLE_PATH)
    if not sample.is_file():
        print(f"ERROR sample not found: {SAMPLE_PATH}", file=sys.stderr)
        return 2
    entries = _parse_csv_hex(ENTRY_POINTS_CSV)
    if not entries:
        print("ERROR no entry points parsed from: " + ENTRY_POINTS_CSV, file=sys.stderr)
        return 2

    targets = interesting_targets()
    summary = {"sample_sha256": SAMPLE_SHA256, "entry_points": [hex(e) for e in entries],
               "xref_targets": [hex(t) for t in targets], "entries": []}
    try:
        for entry in entries:
            insns = disassemble_at(entry)
            if not insns:
                print(f"WARN no instructions at {hex(entry)}", file=sys.stderr)
            summary["entries"].append(analyze(entry, insns))
    except NotImplementedError as e:
        print(f"DISASM_NOT_IMPLEMENTED: {e}", file=sys.stderr)
        return 1

    out = Path(OUTPUT_DIR)
    out.mkdir(parents=True, exist_ok=True)
    manifest_path = out / "summary.json"
    manifest_path.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    print(f"summary -> {manifest_path} (entries: {[hex(e) for e in entries]})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
