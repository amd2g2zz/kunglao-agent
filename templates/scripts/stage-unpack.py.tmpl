#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""{{name}} — stage-unpack analysis skeleton (generated by scripts/template_gen.py, #278).

FIELD-PROVEN FLOW this skeleton encodes (templates/scripts/stage-unpack.py.tmpl):
  1. carve each stage blob out of the packed sample at CARVE_OFFSETS
  2. sha256 every carved stage (integrity + dedup against known stage hashes)
  3. dump the stages + a JSON manifest into OUTPUT_DIR

WHAT THE ANALYST MUST FILL (all marked TODO in the body):
  * carve_stages() — the actual carve boundaries for THIS sample's packer
    (offset table location, size fields, any per-stage de-obfuscation)
  * verify_expected() — optional cross-check of carved hashes against the
    packer's embedded stage table before dumping

CLI:  python {{name}}.py
Exit: 0 = all stages carved, hashed and dumped; 1 = carve failed/incomplete;
      2 = configuration error (offsets/names mismatch, sample missing).
"""
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path

# ---- parameters (instantiated by template_gen.py from stage-unpack) ----
SAMPLE_PATH = "{{sample_path}}"
SAMPLE_SHA256 = "{{sample_sha256}}"
CARVE_OFFSETS_CSV = "{{offsets}}"    # e.g. "0x1a00,0x3c40" — comma-separated hex
STAGE_NAMES_CSV = "{{stage_names}}"  # e.g. "stage1,stage2" — same count as offsets
OUTPUT_DIR = "{{output_dir}}"


def _sha256_file(path: Path) -> str:
    """sha256 of a file's bytes (mechanical, no analyst input needed)."""
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def _parse_csv_int_hex(text: str) -> list[int]:
    """'0x1a00, 0x3c40' -> [0x1a00, 0x3c40]."""
    return [int(part.strip(), 16) for part in text.split(",") if part.strip()]


def _parse_csv_names(text: str) -> list[str]:
    """'stage1, stage2' -> ['stage1', 'stage2']."""
    return [part.strip() for part in text.split(",") if part.strip()]


def carve_stages(sample: bytes) -> list[tuple[str, bytes]]:
    """TODO(analyst): carve each stage out of the packed sample.

    Field flow: locate the packer's stage table (offset, size, name per
    stage), then slice each stage out of `sample`. Return one
    (stage_name, stage_bytes) entry per CARVE_OFFSETS entry, in order.
    Raise NotImplementedError with a concrete message when a carve cannot
    be determined for this sample.
    """
    raise NotImplementedError(
        "TODO(analyst): implement carving for this sample's packer — "
        "locate the stage table and slice each stage (see template docstring)"
    )


def verify_expected(stages: list[tuple[str, bytes]]) -> list[str]:
    """TODO(analyst, optional): cross-check carved hashes against the packer's
    embedded stage table; return a list of mismatch descriptions (empty = ok).
    Default: no verification (all stages accepted)."""
    return []


def main() -> int:
    sample = Path(SAMPLE_PATH)
    if not sample.is_file():
        print(f"ERROR sample not found: {SAMPLE_PATH}", file=sys.stderr)
        return 2
    offsets = _parse_csv_int_hex(CARVE_OFFSETS_CSV)
    names = _parse_csv_names(STAGE_NAMES_CSV)
    if len(offsets) != len(names):
        print(f"ERROR offsets/stage_names count mismatch: {len(offsets)} vs {len(names)}",
              file=sys.stderr)
        return 2
    sample_bytes = sample.read_bytes()
    print(f"sample={SAMPLE_PATH} size={len(sample_bytes)} sha256={_sha256_file(sample)}")
    try:
        stages = carve_stages(sample_bytes)
    except NotImplementedError as e:
        print(f"CARVE_NOT_IMPLEMENTED: {e}", file=sys.stderr)
        return 1
    mismatches = verify_expected(stages)
    for m in mismatches:
        print(f"WARN stage-verify: {m}", file=sys.stderr)

    out = Path(OUTPUT_DIR)
    out.mkdir(parents=True, exist_ok=True)
    manifest = {"sample_sha256": SAMPLE_SHA256, "stages": []}
    for name, blob in stages:
        stage_sha = hashlib.sha256(blob).hexdigest()
        dump = out / f"{name}.bin"
        dump.write_bytes(blob)
        manifest["stages"].append({"name": name, "size": len(blob), "sha256": stage_sha})
        print(f"stage={name} size={len(blob)} sha256={stage_sha} -> {dump}")
    manifest_path = out / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(f"manifest -> {manifest_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
