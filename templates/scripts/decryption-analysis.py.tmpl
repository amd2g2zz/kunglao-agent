from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path

# ---- parameters (instantiated by template_gen.py from decryption-analysis) ----
SAMPLE_PATH = "{{sample_path}}"
SAMPLE_SHA256 = "{{sample_sha256}}"
DECRYPT_OFFSET = "{{decrypt_offset}}"  # hex VA or file offset of the decrypt routine
KEY_VA = "{{key_va}}"                  # hex VA of the key material
OUTPUT_DIR = "{{output_dir}}"


def _parse_hex(text: str) -> int:
    return int(text.strip(), 16)


def _sha256_file(path: Path) -> str:
    """sha256 of a file's bytes (mechanical, no analyst input needed)."""
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def recover_key(sample: bytes) -> bytes:
