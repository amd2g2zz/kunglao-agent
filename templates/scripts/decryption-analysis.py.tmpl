    )


def main() -> int:
    sample = Path(SAMPLE_PATH)
    if not sample.is_file():
        print(f"ERROR sample not found: {SAMPLE_PATH}", file=sys.stderr)
        return 2
    decrypt_offset = _parse_hex(DECRYPT_OFFSET)
    key_va = _parse_hex(KEY_VA)
    sample_bytes = sample.read_bytes()
    print(f"sample={SAMPLE_PATH} size={len(sample_bytes)} sha256={_sha256_file(sample)}")
    print(f"decrypt_offset={hex(decrypt_offset)} key_va={hex(key_va)}")

    try:
        key = recover_key(sample_bytes)
        plaintext = decrypt_payload(sample_bytes, key)
    except NotImplementedError as e:
        print(f"DECRYPT_NOT_IMPLEMENTED: {e}", file=sys.stderr)
        return 1
    if not plaintext:
        print("ERROR decrypt produced empty plaintext", file=sys.stderr)
        return 1
    plain_sha = hashlib.sha256(plaintext).hexdigest()

    out = Path(OUTPUT_DIR)
    out.mkdir(parents=True, exist_ok=True)
    dump = out / "plaintext.bin"
    dump.write_bytes(plaintext)
    manifest = {"sample_sha256": SAMPLE_SHA256, "decrypt_offset": hex(decrypt_offset),
                "key_va": hex(key_va), "plaintext_size": len(plaintext),
                "plaintext_sha256": plain_sha}
    manifest_path = out / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(f"plaintext size={len(plaintext)} sha256={plain_sha} -> {dump}")
    print(f"manifest -> {manifest_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
