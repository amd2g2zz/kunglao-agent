    Read the key material at the pinned VA (translate VA -> file offset for
    the section layout if needed). Return the raw key bytes.
    """
    raise NotImplementedError(
        "TODO(analyst): extract key material at KEY_VA (see template docstring)"
    )


def decrypt_payload(sample: bytes, key: bytes) -> bytes:
    """TODO(analyst): decrypt the payload region.

    Field flow: determine the data address/size the routine acts on, then
    apply the algorithm. Prefer an existing tools/ crypto entry over a
    hand-rolled loop when the scheme matches one of the 8 algorithm families.
    """
    raise NotImplementedError(
        "TODO(analyst): implement the decrypt algorithm this routine uses "
