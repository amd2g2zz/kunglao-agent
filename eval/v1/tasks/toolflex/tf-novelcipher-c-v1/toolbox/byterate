#!/usr/bin/env python3
# toolbox/byterate — constructed blocked-path inspect tool (#546).
# Synthetic; seed 54602. Byte-class profile only — no digest path.
"""usage: byterate <file>       (byte-class counts: printable/hex/other)
"""
import sys


def main(argv):
    if len(argv) != 1:
        sys.stderr.write("usage: byterate <file>\n")
        return 2
    try:
        raw = open(argv[0], "rb").read()
    except OSError as exc:
        sys.stderr.write("byterate: cannot read: %s\n" % exc)
        return 2
    pr = sum(1 for b in raw if 0x20 <= b < 0x7F)
    lo = sum(1 for b in raw if b < 0x20 or b == 0x7F)
    hi = len(raw) - pr - lo
    sys.stdout.write("printable=%d control=%d high=%d total=%d\n" % (
        pr, lo, hi, len(raw)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
