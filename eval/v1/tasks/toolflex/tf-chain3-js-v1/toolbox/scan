    a = ((key ^ (key >> 30)) * MIX_C) & M64
    a = ((a ^ (a >> 27)) * EXP_C) & M64
    return (a ^ (a >> 31)) & M64, (a + GOLD) & M64


def stage_final(w0, w1, data):
    h = w0 & M64
    mul = (w1 | 1) & M64
    for b in data:
        h = ((h ^ b) * mul) & M64
    return (h ^ (h >> 31)) & M64


