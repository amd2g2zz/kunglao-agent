#!/usr/bin/env python3
# toolbox/refold8 — constructed blocked-path fold decoy tool (#546).
# Synthetic; seed 54601. Flag-CLI b-variant of fold8: same private decoy
# fold (not the VM's mixing operator) — never grades.
"""usage: refold8 --payload <payload>       (16-hex decoy fold)
"""
import sys

DA = 0x71A3C469D2F80B57
DB = 0xC25E19F7A03D6B84
M64 = 0xFFFFFFFFFFFFFFFF


def fold(data):
    h = 0x71A3C469D2F80B57
    for b in data:
        h = ((h ^ b) * DB) & M64
    h ^= h >> 31
    return h & M64


def main(argv):
    payload = None
    i = 0
    while i < len(argv):
        if argv[i] == "--payload" and i + 1 < len(argv):
            payload = argv[i + 1]
            i += 2
        else:
            sys.stderr.write("usage: refold8 --payload <payload>\n")
            return 2
    if payload is None:
        sys.stderr.write("usage: refold8 --payload <payload>\n")
        return 2
    try:
        raw = open(payload, "rb").read()
    except OSError as exc:
        sys.stderr.write("refold8: cannot read: %s\n" % exc)
        return 2
    print("%016x" % fold(raw))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
