#!/usr/bin/env python3
# toolbox/opcount — constructed blocked-path inspect tool (#546).
# Synthetic; seed 54601. Byte histogram only — no digest path.
"""usage: opcount <file>       (top byte-value counts)
"""
import sys


def main(argv):
    if len(argv) != 1:
        sys.stderr.write("usage: opcount <file>\n")
        return 2
    try:
        raw = open(argv[0], "rb").read()
    except OSError as exc:
        sys.stderr.write("opcount: cannot read: %s\n" % exc)
        return 2
    hist = {}
    for b in raw:
        hist[b] = hist.get(b, 0) + 1
    top = sorted(hist.items(), key=lambda kv: (-kv[1], kv[0]))[:8]
    sys.stdout.write("top-bytes: " + " ".join(
        "%02x:%d" % (b, n) for b, n in top) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
