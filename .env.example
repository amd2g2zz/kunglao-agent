# kunglao-agent deployment variables (.env.example, #356 W4)
# Copy to <workspace>/.env and fill in. scripts/env_check.py reads it:
# real environment variables win, the workspace .env is the fallback.

# VM lease host for dynamic analysis (unset = T3 blocked, static proceeds)
KUNGLAO_VM_HOST=

# vmr-shell TCP port on the VM (default 9876)
KUNGLAO_VM_SHELL_PORT=

# custom Frida port on the VM/device (renamed frida-server convention, default 1337)
KUNGLAO_FRIDA_PORT=

# Ghidra install root; support/analyzeHeadless.bat must exist under it
GHIDRA_HOME=

# override for the user-level ~/.claude.json MCP registry (mainly tests)
KUNGLAO_CLAUDE_JSON=

# path to the DIE (Detect It Easy) executable; fallback to PATH
KUNGLAO_DIE=
